# AstroBot configuration template.
# Copy this file to .env and paste in your own values. .env is git-ignored, so keys never reach GitHub.

# Webex personal access token from https://developer.webex.com/docs/getting-started
# (personal tokens expire 12 hours after they are issued)
WEBEX_ACCESS_TOKEN=

# OpenWeather API key from https://home.openweathermap.org/api_keys
# (a brand-new key can take a while to activate; until then the API returns 401)
OPENWEATHER_API_KEY=
